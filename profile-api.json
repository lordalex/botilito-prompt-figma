{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Gestión de Perfiles y Gamificación (Digitalia)",
    "description": "Especificación detallada para la Edge Function `profileCRUD`. Este servicio gestiona los perfiles de usuario, calcula estadísticas en tiempo real, procesa la lógica de gamificación (rachas, experiencia, insignias) y permite la administración de retos.",
    "version": "2.1.0",
    "contact": {
      "name": "Soporte Digitalia",
      "email": "soporte@digitalia.gov.co"
    }
  },
  "servers": [
    {
      "url": "https://mdkswlgcqsmgfmcuorxq.supabase.co/functions/v1/profileCRUD",
      "description": "Servidor de Producción (Supabase Edge Function)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT de Supabase Auth del usuario autenticado."
      }
    },
    "schemas": {
      "UserProfile": {
        "type": "object",
        "description": "Objeto completo del perfil de usuario enriquecido con estadísticas y estado de gamificación.",
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "Identificador único del usuario." },
          "email": { "type": "string", "format": "email", "description": "Correo electrónico del usuario." },
          "role": { "type": "string", "description": "Rol del sistema (ej. 'admin', 'user')." },
          "nombre_completo": { "type": "string", "description": "Nombre completo del usuario." },
          "numero_telefono": { "type": "string", "description": "Número de contacto." },
          "departamento": { "type": "string", "description": "Departamento geográfico de residencia." },
          "ciudad": { "type": "string", "description": "Ciudad de residencia. Crítico para el cálculo de zona horaria de las rachas." },
          "fecha_nacimiento": { "type": "string", "format": "date", "description": "Fecha de nacimiento (YYYY-MM-DD)." },
          "reputation": { "type": "integer", "description": "Puntos de reputación acumulados." },
          "xp": { "type": "integer", "description": "Puntos de Inteligencia (PI) o Experiencia acumulada. Se actualiza dinámicamente con las rachas." },
          "badges": { 
            "type": "array", 
            "items": { "type": "string" }, 
            "description": "Lista de nombres de insignias desbloqueadas." 
          },
          "current_streak": { "type": "integer", "description": "Racha actual de días consecutivos reportando casos." },
          "best_streak": { "type": "integer", "description": "Mejor racha histórica alcanzada." },
          "last_activity_at": { "type": "string", "format": "date-time", "description": "Marca de tiempo del último reporte de caso procesado para la racha." },
          "photo": { "type": "string", "nullable": true, "description": "Cadena Base64 de la foto de perfil (o URL)." },
          "avatar": { "type": "string", "nullable": true, "description": "Cadena Base64 del avatar (o URL)." },
          "stats": { "$ref": "#/components/schemas/UserStats" }
        }
      },
      "UserStats": {
        "type": "object",
        "description": "Estadísticas calculadas en tiempo real para el dashboard.",
        "properties": {
          "cases_registered": { "type": "integer", "description": "Total de documentos/casos reportados por el usuario." },
          "validations_performed": { "type": "integer", "description": "Total de votos o validaciones realizadas." },
          "global_ranking": { "type": "integer", "description": "Posición actual en el ranking global basado en XP." },
          "total_users": { "type": "integer", "description": "Número total de usuarios registrados en la plataforma." },
          "next_rank_progress": {
            "type": "object",
            "properties": {
              "current": { "type": "integer", "description": "XP actual." },
              "target": { "type": "integer", "description": "XP necesaria para el siguiente rango." },
              "label": { "type": "string", "description": "Nombre del rango actual (ej. 'Cibernauta Centinela')." }
            }
          }
        }
      },
      "ChallengeProgress": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "badge_name": { "type": "string" },
          "completed": { "type": "boolean", "description": "Indica si el usuario ya completó este reto." },
          "percent": { "type": "integer", "description": "Porcentaje de progreso (0-100)." },
          "reward_display": { "type": "string", "description": "Texto formateado de la recompensa (ej. '400 PI')." }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "description": "Campos permitidos para actualizar. Todos son opcionales.",
        "properties": {
          "nombre_completo": { "type": "string" },
          "numero_telefono": { "type": "string" },
          "departamento": { "type": "string" },
          "ciudad": { "type": "string", "description": "Actualizar esto puede cambiar la zona horaria para el cálculo de rachas." },
          "fecha_nacimiento": { "type": "string", "format": "date" },
          "photo": { "type": "string", "description": "Imagen en formato Base64. Máximo 2MB." },
          "avatar": { "type": "string", "description": "Imagen en formato Base64. Máximo 2MB." }
        }
      },
      "ConversionRequest": {
        "type": "object",
        "required": ["amount", "from"],
        "properties": {
          "amount": { "type": "number", "description": "Cantidad a convertir." },
          "from": { "type": "string", "enum": ["xp", "reputation"], "description": "Unidad de origen." }
        }
      },
      "ConversionResponse": {
        "type": "object",
        "properties": {
          "input": { 
            "type": "object",
            "properties": { "amount": { "type": "number" }, "unit": { "type": "string" } }
          },
          "conversion": { 
            "type": "object",
            "properties": { "amount": { "type": "number" }, "unit": { "type": "string" } }
          }
        }
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Obtener Perfil y Calcular Racha",
        "description": "Recupera los detalles del perfil del usuario. **IMPORTANTE:** Este endpoint dispara el motor de cálculo de rachas ('Streak Engine'). Verifica si se han reportado nuevos casos desde la última actividad, calcula la diferencia de días basándose en la zona horaria de la ciudad del usuario, actualiza la racha actual, y otorga recompensas (XP) e insignias automáticamente si corresponde.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "UUID del usuario objetivo. Si se omite, retorna el perfil del usuario autenticado (token)."
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil recuperado exitosamente con cálculo de racha actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/UserProfile" },
                    "challenges_progress": { 
                      "type": "array", 
                      "items": { "$ref": "#/components/schemas/ChallengeProgress" } 
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": "a1b2c3d4...",
                    "email": "usuario@ejemplo.com",
                    "xp": 1520,
                    "reputation": 50,
                    "current_streak": 5,
                    "best_streak": 10,
                    "ciudad": "Bogotá",
                    "badges": ["Plata - Compromiso Inquebrantable"],
                    "stats": {
                      "cases_registered": 45,
                      "validations_performed": 12,
                      "global_ranking": 3,
                      "total_users": 150,
                      "next_rank_progress": { "current": 1520, "target": 3001, "label": "Cibernauta Centinela" }
                    }
                  },
                  "challenges_progress": [
                    { "id": "...", "title": "Misión Inicial", "completed": true, "percent": 100, "reward_display": "100 PI" }
                  ]
                }
              }
            }
          },
          "401": { "description": "No autorizado. Token faltante o inválido." },
          "404": { "description": "Perfil de usuario no encontrado." }
        }
      },
      "put": {
        "summary": "Actualizar Información del Perfil",
        "description": "Permite al usuario actualizar su información personal. Incluye validación estricta para imágenes en Base64 (Límite de 2MB). Si la ciudad se actualiza, el cálculo de la racha futura se ajustará a la nueva zona horaria.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" },
              "example": {
                "nombre_completo": "Juan Pérez",
                "ciudad": "Medellín",
                "photo": "data:image/jpeg;base64,/9j/4AAQSkZJRg..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado correctamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/UserProfile" }
                  }
                }
              }
            }
          },
          "400": { "description": "Error de validación (ej. imagen > 2MB o JSON malformado)." },
          "500": { "description": "Error interno de base de datos." }
        }
      }
    },
    "/convert": {
      "post": {
        "summary": "Convertir Divisas (PI <-> Reputación)",
        "description": "Utilidad pública para calcular el cambio entre Puntos de Inteligencia (XP) y Reputación. La tasa actual es 1 Reputación = 25 XP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConversionRequest" },
              "example": { "amount": 100, "from": "xp" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cálculo exitoso.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConversionResponse" },
                "example": {
                  "input": { "amount": 100, "unit": "xp" },
                  "conversion": { "amount": 4, "unit": "reputation" }
                }
              }
            }
          }
        }
      }
    },
    "/challenges": {
      "post": {
        "summary": "Crear Reto de Gamificación (Admin)",
        "description": "Permite a los administradores definir nuevos retos y recompensas. Estos retos se verifican automáticamente cuando los usuarios consultan su perfil. Requiere que el usuario tenga el rol 'admin' en la tabla `perfiles_usuario`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "badge_name"],
                "properties": {
                  "title": { "type": "string", "example": "Cazador de Mitos" },
                  "description": { "type": "string", "example": "Valida 50 noticias falsas." },
                  "badge_name": { "type": "string", "example": "Insignia de Cazador" },
                  "required_xp": { "type": "integer", "example": 1000 },
                  "required_reputation": { "type": "integer", "example": 20 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Reto creado exitosamente." },
          "403": { "description": "Prohibido. El usuario no es administrador." }
        }
      }
    }
  }
}

